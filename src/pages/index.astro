---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArtistCard from '../components/ArtistCard.astro';
import { getActiveArtists, getFeaturedEvent, getGalleryItems, loadFrontmatter, paragraphs } from '../lib/content';

const artists = await getActiveArtists();
const featuredEvent = await getFeaturedEvent();
// Full gallery + artist pools; the page picks a MONTHLY subset in the browser
// (see the script below) and only the shown images are loaded — no rebuild needed.
const galleryPool = (await getGalleryItems()).map((g) => ({ image: g.data.image, alt: g.data.alt }));

// Editable homepage content (CMS → "Home Page"). Every field falls back to a
// sensible default if left blank, so the page never breaks.
const home = loadFrontmatter('src/content/pages/home.md');

const heroEyebrow = home.heroEyebrow || 'welcome to';
const heroTitle = home.heroTitle || 'Creative Arts Association of Lakewood Ranch';
const heroText = home.heroText || '';
const storyTitle = home.storyTitle || 'From a Park to a Community';
const storyParagraphs = paragraphs(home.introText);
const storyImages: string[] = Array.isArray(home.storyImages) ? home.storyImages : [];
---
<BaseLayout
  title="Creative Arts Association of Lakewood Ranch"
  description="A nonprofit fostering visual artists in Lakewood Ranch through exhibitions, education, and community since 2001. Create. Connect. Inspire."
>

  {/* Split hero — text left, rotating ART photos right */}
  <section class="split-hero">
    <div class="container split-hero__inner">
      <div class="split-hero__text">
        <p class="script script--lg" style="color: var(--color-coral);">{heroEyebrow}</p>
        <h1>{heroTitle}</h1>
        <p>{heroText}</p>
        <div class="split-hero__actions">
          <a href="/artists/" class="btn btn--coral">Meet Our Artists</a>
          <a href="/events/" class="btn btn--outline">Upcoming Shows</a>
        </div>
      </div>
      <div class="split-hero__slideshow" data-monthly="hero">
        {galleryPool.map((item) => (
          <img data-src={item.image} alt={item.alt} class="slideshow-img" />
        ))}
      </div>
    </div>
  </section>

  {/* Upcoming event banner */}
  {featuredEvent && (
    <section class="exhibition-banner">
      <div class="container exhibition-banner__inner">
        <div class="exhibition-banner__label">
          <span class="script">upcoming</span>
          <span class="exhibition-banner__dot"></span>
        </div>
        <div class="exhibition-banner__info">
          <h2>{featuredEvent.data.title}</h2>
          <p>{featuredEvent.data.venueName}</p>
        </div>
        <a href={`/events/${featuredEvent.id.replace(/\.md$/, '')}/`} class="btn btn--outline">View Details</a>
      </div>
    </section>
  )}

  {/* Our Story — people slideshow LEFT, text RIGHT (flipped direction) */}
  <section class="section section--warm">
    <div class="container story-section">
      <div class="story-section__slideshow">
        {storyImages.map((src, i) => (
          <img src={src} alt="CAALR members at an art show" class:list={['people-img', { active: i === 0 }]} />
        ))}
      </div>
      <div class="story-section__text">
        <p class="script script--lg" style="color: var(--color-coral); margin-bottom: 0;">our story</p>
        <h2>{storyTitle}</h2>
        {storyParagraphs.map((p) => <p>{p}</p>)}
        <a href="/about/" class="btn btn--outline" style="margin-top: var(--space-xs);">Learn More About Us</a>
      </div>
    </div>
  </section>

  {/* Artists */}
  {artists.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading label="meet our" title="Artists" subtitle="Talented artists working across many mediums" />
        <div class="grid grid--4" data-monthly="artists">
          {artists.map((artist) => (
            <ArtistCard name={artist.data.name} slug={artist.id.replace(/\.md$/, '')} mediums={artist.data.mediums} shortBio={artist.data.shortBio} featuredImage={artist.data.featuredImage} photoIsTemp={artist.data.photoIsTemp} deferred />
          ))}
        </div>
        <div class="text-center" style="margin-top: var(--space-md);">
          <a href="/artists/" class="btn btn--primary">View All {artists.length} Artists</a>
        </div>
      </div>
    </section>
  )}

  {/* Gallery Preview */}
  {galleryPool.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeading label="from the studio" title="Gallery" subtitle="A look at our members' work" />
        <div class="gallery-preview" data-monthly="preview">
          {galleryPool.map((item) => (
            <div class="gallery-preview__item is-hidden">
              <img data-src={item.image} alt={item.alt} loading="lazy" width="400" height="400" />
            </div>
          ))}
        </div>
        <div class="text-center" style="margin-top: var(--space-md);">
          <a href="/gallery/" class="btn btn--secondary">View Full Gallery</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Split hero */
  .split-hero {
    background: var(--color-sunshine);
    padding: var(--space-lg) 0;
  }
  .split-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .split-hero__text h1 {
    font-size: var(--font-size-3xl);
    color: var(--color-green-dark);
    margin-bottom: var(--space-sm);
  }
  .split-hero__text p {
    color: var(--color-drift);
    margin-bottom: var(--space-sm);
  }
  .split-hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .split-hero__slideshow {
    position: relative;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .slideshow-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .slideshow-img.active { opacity: 1; }

  /* Exhibition banner */
  .exhibition-banner {
    background: var(--color-green-dark);
    color: white;
    padding: var(--space-md) 0;
  }
  .exhibition-banner__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .exhibition-banner__label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }
  .exhibition-banner__label .script { color: var(--color-gold-bright); font-size: var(--font-size-lg); }
  .exhibition-banner__dot {
    width: 8px;
    height: 8px;
    background: var(--color-coral);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .exhibition-banner__info { flex: 1; }
  .exhibition-banner__info h2 { font-size: var(--font-size-lg); margin: 0; color: white; }
  .exhibition-banner__info p { margin: 0; opacity: 0.8; font-size: var(--font-size-sm); }
  .exhibition-banner .btn--outline { border-color: rgba(255,255,255,0.5); color: white; white-space: nowrap; }
  .exhibition-banner .btn--outline:hover { border-color: white; background: rgba(255,255,255,0.1); }

  @media (max-width: 768px) {
    .split-hero__inner { grid-template-columns: 1fr; }
    .split-hero__text h1 { font-size: var(--font-size-2xl); }
  }

  /* Story section — photos LEFT, text RIGHT */
  .story-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .story-section__slideshow {
    position: relative;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .people-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .people-img.active { opacity: 1; }
  @media (max-width: 768px) {
    .story-section { grid-template-columns: 1fr; }
    .story-section__slideshow { order: -1; }
  }

  /* Gallery preview */
  .gallery-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .gallery-preview__item {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .gallery-preview__item:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }
  .gallery-preview__item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .gallery-preview__item:first-child { grid-row: span 2; }
  .gallery-preview__item:first-child img { aspect-ratio: auto; height: 100%; }
  @media (max-width: 600px) {
    .gallery-preview { grid-template-columns: repeat(2, 1fr); }
    .gallery-preview__item:first-child { grid-row: span 1; }
  }
</style>

<script is:inline>
  (function () {
    // Deterministic MONTHLY selection: same for everyone within a month, changes
    // on the 1st, no rebuild needed. Only the chosen images are ever loaded.
    function rng(seed) {
      return function () {
        seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
        var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    function monthlyPick(total, n, offset) {
      var d = new Date();
      var rnd = rng(d.getFullYear() * 12 + d.getMonth() + (offset || 0));
      var idx = []; for (var i = 0; i < total; i++) idx.push(i);
      for (var i = idx.length - 1; i > 0; i--) { var j = Math.floor(rnd() * (i + 1)); var t = idx[i]; idx[i] = idx[j]; idx[j] = t; }
      return idx.slice(0, Math.min(n, total));
    }
    function load(img) { if (img && img.dataset && img.dataset.src) img.src = img.dataset.src; }

    // Hero artwork — 8 per month
    var hero = document.querySelector('[data-monthly="hero"]');
    var live = [];
    if (hero) {
      var imgs = hero.querySelectorAll('.slideshow-img');
      monthlyPick(imgs.length, 8, 0).forEach(function (i, k) { var el = imgs[i]; load(el); el.classList.add('is-live'); if (k === 0) el.classList.add('active'); live.push(el); });
    }
    if (live.length > 1) { var c = 0; setInterval(function () { live[c].classList.remove('active'); c = (c + 1) % live.length; live[c].classList.add('active'); }, 4000); }

    // Gallery preview — 6 per month (separate draw)
    var pv = document.querySelector('[data-monthly="preview"]');
    if (pv) { var items = pv.querySelectorAll('.gallery-preview__item'); monthlyPick(items.length, 6, 1000).forEach(function (i) { var it = items[i]; it.classList.remove('is-hidden'); load(it.querySelector('img')); }); }

    // Featured artists — 8 per month
    var ag = document.querySelector('[data-monthly="artists"]');
    if (ag) { var cards = ag.querySelectorAll('.artist-card'); monthlyPick(cards.length, 8, 500).forEach(function (i) { var card = cards[i]; card.classList.remove('is-hidden'); load(card.querySelector('img')); }); }

    // People/community slideshow (server-rendered, not monthly)
    var people = document.querySelectorAll('.people-img');
    if (people.length > 1) { var p = 0; setInterval(function () { people[p].classList.remove('active'); p = (p + 1) % people.length; people[p].classList.add('active'); }, 5000); }
  })();
</script>
