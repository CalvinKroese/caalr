---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { getGalleryItems, loadFrontmatter } from '../lib/content';

const gallery = await getGalleryItems();
const page = loadFrontmatter('src/content/pages/gallery.md');
const images = gallery.map((item) => ({
  title: item.data.title,
  image: item.data.image,
  alt: item.data.alt,
  artistSlug: item.data.artistSlug,
}));
---
<BaseLayout title="Gallery" description="Browse artwork by members of the Creative Arts Association of Lakewood Ranch.">
  <Hero title={page.heroTitle || 'Gallery'} subtitle={page.heroSubtitle || 'Artwork by CAALR members'} scriptLabel={page.heroScript || 'from the studio'} compact />

  <section class="section">
    <div class="container">
      <GalleryGrid images={images} />
    </div>
  </section>
</BaseLayout>
